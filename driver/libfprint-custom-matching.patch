diff --git a/libfprint/fpi-image-device.h b/libfprint/fpi-image-device.h
index 71472dbb..bd18d469 100644
--- a/libfprint/fpi-image-device.h
+++ b/libfprint/fpi-image-device.h
@@ -114,6 +114,25 @@ struct _FpImageDeviceClass
   void          (*change_state) (FpImageDevice      *dev,
                                  FpiImageDeviceState state);
   void          (*deactivate)   (FpImageDevice *dev);
+
+  /* Frames from some sensors are far too small for minutiae extraction to
+   * find anything usable. A driver that provides both of these takes over:
+   * minutiae detection is skipped, prints carry whatever @serialize_image
+   * returns, and @compare_data decides matches.
+   *
+   * @serialize_image turns one capture into driver-specific data, or NULL to
+   * ask the user to try again.
+   *
+   * @compare_data is handed the probe's data and the array of blobs collected
+   * so far. @enrolling tells it which question is being asked: during
+   * enrolment it guards coherence between captures, and a driver will usually
+   * want a stricter bar there than when deciding a match. */
+  GVariant   * (*serialize_image) (FpImageDevice *dev,
+                                   FpImage       *image);
+  gboolean     (*compare_data)    (FpImageDevice *dev,
+                                   GVariant      *probe,
+                                   GVariant      *enrolled,
+                                   gboolean       enrolling);
 };
 
