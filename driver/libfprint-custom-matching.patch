+/* Appends one blob to the array a print accumulates during enrolment. */
+static void
+image_device_accumulate (FpPrint *enroll_print, GVariant *blob)
+{
+  g_autoptr(GVariant) existing = NULL;
+  GVariantBuilder builder;
+
+  g_object_get (enroll_print, "fpi-data", &existing, NULL);
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("aay"));
+
+  if (existing && g_variant_is_of_type (existing, G_VARIANT_TYPE ("aay")))
+    {
+      GVariantIter iter;
+      GVariant *child;
+
+      g_variant_iter_init (&iter, existing);
+      while ((child = g_variant_iter_next_value (&iter)))
+        {
+          g_variant_builder_add_value (&builder, child);
+          g_variant_unref (child);
+        }
+    }
+
+  g_variant_builder_add_value (&builder, blob);
+  g_object_set (enroll_print, "fpi-data",
+                g_variant_builder_end (&builder), NULL);
+}
+
+/* Same job as fpi_image_device_minutiae_detected, for drivers that supply
+ * their own comparison instead of relying on NBIS. */
+static void
+image_device_custom_captured (FpImageDevice *self, FpImage *image)
+{
+  FpDevice *device = FP_DEVICE (self);
+  FpImageDeviceClass *klass = FP_IMAGE_DEVICE_GET_CLASS (self);
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+  FpiDeviceAction action = fpi_device_get_current_action (device);
+
+  g_autoptr(FpPrint) print = NULL;
+  g_autoptr(GVariant) data = NULL;
+  GError *error = NULL;
+
+  if (action == FPI_DEVICE_ACTION_CAPTURE)
+    {
+      priv->capture_image = g_object_ref (image);
+      fp_image_device_maybe_complete_action (self, NULL);
+      return;
+    }
+
+  data = klass->serialize_image (self, image);
+  if (data)
+    g_variant_ref_sink (data);
+
+  if (data == NULL)
+    {
+      error = fpi_device_retry_new_msg (FP_DEVICE_RETRY_GENERAL,
+                                        "Could not use this scan, please retry");
+    }
+  else
+    {
+      print = fp_print_new (device);
+      fpi_print_set_type (print, FPI_PRINT_RAW);
+      g_object_set (print, "fpi-data", data, NULL);
+    }
+
+  if (action == FPI_DEVICE_ACTION_ENROLL)
+    {
+      FpPrint *enroll_print;
+
+      fpi_device_get_enroll_data (device, &enroll_print);
+
+      /* A touch that matches none of the ones already kept covers a different
+       * patch of skin. Keeping it scatters the enrolment, which drags later
+       * scores down and, worse, makes the stored print describe skin in
+       * general rather than this finger. Ask for it again instead. */
+      if (print && priv->enroll_stage > 0)
+        {
+          g_autoptr(GVariant) accumulated = NULL;
+
+          g_object_get (enroll_print, "fpi-data", &accumulated, NULL);
+
+          if (accumulated && !klass->compare_data (self, data, accumulated, TRUE))
+            {
+              g_clear_object (&print);
+              error = fpi_device_retry_new_msg (FP_DEVICE_RETRY_CENTER_FINGER,
+                                                "Put the same part of the "
+                                                "finger down as before");
+            }
+        }
+
+      if (print)
+        {
+          /* The type was settled when the enroll action started. */
+          image_device_accumulate (enroll_print, data);
+          priv->enroll_stage += 1;
+        }
+
+      fpi_device_enroll_progress (device, priv->enroll_stage,
+                                  g_steal_pointer (&print), error);
+
+      if (priv->enroll_stage == fp_device_get_nr_enroll_stages (device))
+        {
+          fp_image_device_maybe_complete_action (self, NULL);
+          fpi_image_device_deactivate (self, FALSE);
+        }
+      else
+        {
+          fp_image_device_enroll_maybe_await_finger_on (self);
+        }
+    }
+  else if (action == FPI_DEVICE_ACTION_IDENTIFY)
+    {
+      GPtrArray *templates;
+      FpPrint *result = NULL;
+
+      fpi_device_get_identify_data (device, &templates);
+
+      for (guint i = 0; print && i < templates->len; i++)
+        {
+          FpPrint *candidate = g_ptr_array_index (templates, i);
+          g_autoptr(GVariant) enrolled = NULL;
+
+          g_object_get (candidate, "fpi-data", &enrolled, NULL);
+          if (enrolled == NULL)
+            continue;
+
+          if (klass->compare_data (self, data, enrolled, FALSE))
+            {
+              result = candidate;
+              break;
+            }
+        }
+
+      fpi_device_identify_report (device, result, g_steal_pointer (&print),
+                                  error);
+      fp_image_device_maybe_complete_action (self, NULL);
+    }
+  else
+    {
+      g_clear_error (&error);
+    }
+}
